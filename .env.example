# Path to your OAuth client auth JSON (Google Docs publisher)
OAUTH_FILE_PATH=/path/to/your.oauth.client.json
# Redirect port for browser OAuth callback
OAUTH_REDIRECT_PORT=8080

# Jira configuration for jira_adapter.py (primary Jira integration — agents must use this, not Atlassian MCP)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=your-jira-api-token

# Polarion configuration for polarion_adapter.py
POLARION_BASE_URL=https://polarion.example.com
POLARION_PROJECT_ID=OSE
POLARION_TOKEN=your-polarion-bearer-token

# OpenShift / kubectl (Phase 2–3 cluster work); agents use the path the user provides
# KUBECONFIG=/path/to/your/kubeconfig

# Optional: convenience for Polarion traceability when POLARION_TRACE_* are not set
# METALLB_JIRA_EPIC_KEY=YOUR-EPIC-KEY
# METALLB_JIRA_BROWSE_URL_BASE=https://issues.redhat.com/browse
# METALLB_HIGH_LEVEL_PLAN_URL=https://docs.google.com/document/d/.../edit
# METALLB_DETAILED_PLAN_URL=https://docs.google.com/document/d/.../edit

# Optional: default epic module for scripts/publish_polarion_livedoc_tests.py (overridden by --epic-module)
# POLARION_EPIC_MODULE=polarion_livedoc_epic_module.sample_epic

# Optional: traceability links embedded in Polarion HTML (any epic)
# POLARION_TRACE_EPIC_URL=https://issues.redhat.com/browse/YOUR-EPIC-KEY
# POLARION_TRACE_EPIC_LABEL=YOUR-EPIC-KEY
# POLARION_TRACE_HIGH_LEVEL_PLAN_URL=https://docs.google.com/document/d/.../edit
# POLARION_TRACE_DETAILED_PLAN_URL=https://docs.google.com/document/d/.../edit
